# AI Provider (gemini | groq)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_optional_groq_api_key_for_fast_whisper

# Google OAuth2 Credentials (Covers BOTH YouTube & Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
YT_REFRESH_TOKEN=your_long_lived_refresh_token

# Google Drive Cloud Folders (Paste the Folder ID from the Google Drive URL)
GDRIVE_INBOX_FOLDER_ID=your_drive_inbox_folder_id_for_raw_videos
GDRIVE_OUTPUT_FOLDER_ID=your_drive_output_folder_id_for_finished_shorts

# Scheduling Settings
POST_GAP_HOURS=3
DAILY_SHORT_CAP=6

# Facebook Page Reels & Instagram Reels (Optional — auto-posts when set)
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
IG_USER_ID=your_instagram_professional_user_id
IG_ACCESS_TOKEN=your_instagram_or_facebook_page_token
